# MIDDLE image — host-TDD of FreeRTOS adapters.
#
# Layered on top of the GCC + CppUTest base, adding upstream FreeRTOS-Kernel,
# FreeRTOS-Plus-TCP, FreeRTOS-Plus-FAT, lwIP, FatFs (ChaN), LittleFS, Mbed TLS,
# wolfSSL, CMSIS_6 and CMSIS-FreeRTOS sources at fixed paths.
# Adapter source files compile in the consumer's project against fakes from
# Tests/Support/FreeRtosFakes/ — see SolidSyslog repo, S08.01.
#
# No cross compiler. See dockerfile.cross for the target-build variant.

# Renovate moves the digest when cpputest publishes (renovate.json); the tag is the
# line it follows, and never what is pulled.
FROM ghcr.io/cososo-ltd/cpputest:latest@sha256:fe1281f3696822ba6cc0d2f6b32238559a77e04f0b7090e75f2ad96fb2001613
LABEL Description="CppUTest base + FreeRTOS / CMSIS-RTOS2 / FatFs / LittleFS / Mbed TLS / wolfSSL sources for host-side TDD"

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
 && apt-get install -y --no-install-recommends xxd \
 && rm -rf /var/lib/apt/lists/*

# Each upstream is pulled at a release tag (or commit SHA where no tag exists)
# and SHA-gated so a moved tag fails the build loudly.
#
# The "# renovate:" comment above each pin is read by Renovate (renovate.json),
# which opens a pull request moving the tag and the SHA together when upstream
# releases. The comment names the datasource, the repository and, where the
# tag shape is not plain semver, the versioning that ranks it. A new pin needs
# the comment to be picked up; see README.md.

# renovate: datasource=git-tags packageName=https://github.com/FreeRTOS/FreeRTOS-Kernel.git versioning=regex:^V(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
ARG FREERTOS_KERNEL_TAG=V11.3.3
ARG FREERTOS_KERNEL_SHA=89592801dd8b73329a7583719b7e3567b50910e5
RUN git clone --depth=1 --branch=${FREERTOS_KERNEL_TAG} \
      https://github.com/FreeRTOS/FreeRTOS-Kernel.git /opt/freertos/kernel \
 && cd /opt/freertos/kernel \
 && [ "$(git rev-parse HEAD)" = "${FREERTOS_KERNEL_SHA}" ] \
 && git submodule update --init --recursive --depth=1
ENV FREERTOS_KERNEL_PATH=/opt/freertos/kernel

# renovate: datasource=git-tags packageName=https://github.com/FreeRTOS/FreeRTOS-Plus-TCP.git versioning=regex:^V(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)$
ARG FREERTOS_PLUS_TCP_TAG=V4.4.2
ARG FREERTOS_PLUS_TCP_SHA=b86ad086e9870099bb0ac18a75dcb7f6dd508cc7
RUN git clone --depth=1 --branch=${FREERTOS_PLUS_TCP_TAG} \
      https://github.com/FreeRTOS/FreeRTOS-Plus-TCP.git /opt/freertos/plus-tcp \
 && cd /opt/freertos/plus-tcp \
 && [ "$(git rev-parse HEAD)" = "${FREERTOS_PLUS_TCP_SHA}" ] \
 && git submodule update --init --recursive --depth=1
ENV FREERTOS_PLUS_TCP_PATH=/opt/freertos/plus-tcp

# FreeRTOS-Plus-FAT — FAT filesystem for the FreeRTOS-Plus ecosystem, designed
# to coexist with FreeRTOS-Plus-TCP. A FreeRTOS *Labs* project
# (github.com/FreeRTOS/Lab-Project-FreeRTOS-FAT) — it ships no release tags, so
# we pin the main-branch commit and SHA-gate it: a moved main fails the build
# loudly, and Renovate opens the bump that moves the SHA. Switch to a release
# tag if upstream ever publishes one. Ships alongside FatFs (ChaN): consumers
# pick per target — the lwIP target uses FatFs, the Plus-TCP target uses
# Plus-FAT (SolidSyslog E29). No submodules.
# renovate: datasource=git-refs packageName=https://github.com/FreeRTOS/Lab-Project-FreeRTOS-FAT.git
ARG FREERTOS_PLUS_FAT_BRANCH=main
ARG FREERTOS_PLUS_FAT_SHA=9ca465c3f2426c301b6b660286f3f964a2abdce5
RUN git init /opt/freertos/plus-fat \
 && cd /opt/freertos/plus-fat \
 && git remote add origin https://github.com/FreeRTOS/Lab-Project-FreeRTOS-FAT.git \
 && git fetch --depth 1 origin ${FREERTOS_PLUS_FAT_SHA} \
 && git checkout FETCH_HEAD
ENV FREERTOS_PLUS_FAT_PATH=/opt/freertos/plus-fat

# lwIP — second FreeRTOS networking backend (alongside FreeRTOS-Plus-TCP).
# Consumers pick one at build time via the SOLIDSYSLOG_FREERTOS_NET CMake
# option; both stacks ship in the same image so a single dev container can
# context-switch between them. lwIP's Raw API supports NO_SYS=1 (bare-metal
# or RTOS without a dedicated IP task) which Plus-TCP does not, covering
# embedded customers already on lwIP. Pulled from the GitHub mirror to match
# the existing dockerfile pattern. No submodules.
# renovate: datasource=git-tags packageName=https://github.com/lwip-tcpip/lwip.git versioning=regex:^STABLE-(?<major>\d+)_(?<minor>\d+)_(?<patch>\d+)_RELEASE$
ARG LWIP_TAG=STABLE-2_2_1_RELEASE
ARG LWIP_SHA=77dcd25a72509eb83f72b033d219b1d40cd8eb95
RUN git clone --depth=1 --branch=${LWIP_TAG} \
      https://github.com/lwip-tcpip/lwip.git /opt/lwip \
 && cd /opt/lwip \
 && [ "$(git rev-parse HEAD)" = "${LWIP_SHA}" ]
ENV LWIP_PATH=/opt/lwip

# FatFs (ChaN) — the de facto embedded filesystem (used by Zephyr, NuttX,
# MicroPython, STM32 HAL, ESP-IDF, Arduino SD ecosystem). ChaN distributes
# FatFs as zip tarballs only — no upstream Git repo — so we pull from the
# long-running community mirror github.com/abbrev/fatfs which faithfully
# tags ChaN's official releases. SHA-gated so a retagged mirror fails the
# build loudly. Renovate bumps R0.x releases; a lettered bugfix release such
# as R0.15a has no numeric order it can rank, so that one is a hand bump.
# renovate: datasource=git-tags packageName=https://github.com/abbrev/fatfs.git versioning=regex:^R(?<major>\d+)\.(?<minor>\d+)$
ARG FATFS_TAG=R0.16
ARG FATFS_SHA=30ca13c62615df0d2e9104ab41256985b96590c1
RUN git clone --depth=1 --branch=${FATFS_TAG} \
      https://github.com/abbrev/fatfs.git /opt/fatfs \
 && cd /opt/fatfs \
 && [ "$(git rev-parse HEAD)" = "${FATFS_SHA}" ]
ENV FATFS_PATH=/opt/fatfs

# LittleFS — power-loss-resilient filesystem for raw NOR/NAND flash, where FAT
# expects an FTL or an SD card underneath. Wear levelling, bounded RAM and
# power-loss handling are design goals of the filesystem itself, which is what
# makes it the third File-role backend (SolidSyslog E36). Two dependency-free C
# files with no submodules, so it also builds on the host for the integration
# suite that proves lfs_file_sync actually commits.
# renovate: datasource=git-tags packageName=https://github.com/littlefs-project/littlefs.git
ARG LITTLEFS_TAG=v2.11.3
ARG LITTLEFS_SHA=6cb4e86540eca0d9ba62500a298385c9d863c8be
RUN git clone --depth=1 --branch=${LITTLEFS_TAG} \
      https://github.com/littlefs-project/littlefs.git /opt/littlefs \
 && cd /opt/littlefs \
 && [ "$(git rev-parse HEAD)" = "${LITTLEFS_SHA}" ]
ENV LITTLEFS_PATH=/opt/littlefs

# renovate: datasource=git-tags packageName=https://github.com/Mbed-TLS/mbedtls.git
ARG MBEDTLS_TAG=v3.6.7
ARG MBEDTLS_SHA=068ff080b369adfac81509f9b57b2afabaf82dc5
RUN git clone --depth=1 --branch=${MBEDTLS_TAG} \
      https://github.com/Mbed-TLS/mbedtls.git /opt/mbedtls \
 && cd /opt/mbedtls \
 && [ "$(git rev-parse HEAD)" = "${MBEDTLS_SHA}" ] \
 && git submodule update --init --recursive --depth=1
ENV MBEDTLS_DIR=/opt/mbedtls

# wolfSSL — the source tree only, nothing built. An embedded integrator
# compiles wolfSSL into their own image under a user_settings.h, and the
# SolidSyslog CMSIS-RTOS2 BDD target does the same (SolidSyslog E34), so what
# it needs from here is the sources at the release the gcc base image builds
# its two host libraries from. Bump the two together: the gate below compares
# the source's version header with the one the base installed, so a base moved
# by Renovate onto a different wolfSSL release fails here rather than publishing
# a source tree that does not match the libraries beside it.
#
# The variable is WOLFSSL_SOURCE_DIR, not WOLFSSL_DIR: SolidSyslog reads
# WOLFSSL_DIR as an installed build with include/ and lib/, and switches its
# wolfSSL host tests on when it is set. The tag is annotated, so the SHA
# checked is the commit it points at. No submodules.
# renovate: datasource=git-tags packageName=https://github.com/wolfSSL/wolfssl.git versioning=regex:^v(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)-stable$
ARG WOLFSSL_TAG=v5.9.4-stable
ARG WOLFSSL_SHA=3c5eead44904df64e6a5a1f4ebdce377d35a849a
RUN git clone --depth=1 --branch=${WOLFSSL_TAG} \
      https://github.com/wolfSSL/wolfssl.git /opt/wolfssl-src \
 && cd /opt/wolfssl-src \
 && [ "$(git rev-parse HEAD)" = "${WOLFSSL_SHA}" ] \
 && src="$(grep LIBWOLFSSL_VERSION_STRING wolfssl/version.h)" \
 && lib="$(grep LIBWOLFSSL_VERSION_STRING "${WOLFSSL_DIR}/include/wolfssl/version.h")" \
 && [ "${src}" = "${lib}" ]
ENV WOLFSSL_SOURCE_DIR=/opt/wolfssl-src


# CMSIS-RTOS2 arrives as two pieces, because neither half is complete alone.
#
# CMSIS_6 carries the API itself — cmsis_os2.h, which is the contract the
# SolidSyslog CmsisRtos pack compiles against (SolidSyslog E40), plus os_tick.h
# and cmsis_compiler.h that the implementation below includes. cmsis_os2.h is
# pure declarations, so a test fake can stand in for it and the pack's unit
# tests need nothing from this image; the BDD target needs the real thing.
# renovate: datasource=git-tags packageName=https://github.com/ARM-software/CMSIS_6.git
ARG CMSIS_TAG=v6.4.0
ARG CMSIS_SHA=af1b110e46a1720349f6f125e386e126767699bd
RUN git clone --depth=1 --branch=${CMSIS_TAG} \
      https://github.com/ARM-software/CMSIS_6.git /opt/cmsis \
 && cd /opt/cmsis \
 && [ "$(git rev-parse HEAD)" = "${CMSIS_SHA}" ]
ENV CMSIS_PATH=/opt/cmsis

# CMSIS-FreeRTOS carries the implementation — CMSIS/RTOS2/FreeRTOS/Source/
# cmsis_os2.c over the kernel already at FREERTOS_KERNEL_PATH. It ships no
# cmsis_os2.h of its own, which is why CMSIS_6 above is not optional.
#
# Pinned to v11.3.0 to match the FreeRTOS-Kernel V11.3 line: the wrapper is
# written against a kernel minor version, so the two move together or not at
# all. The kernel takes that line's patch releases (V11.3.3 against a wrapper
# built on V11.3.0); a new kernel minor waits for its wrapper. Bump both in
# one commit. No submodules.
# renovate: datasource=git-tags packageName=https://github.com/ARM-software/CMSIS-FreeRTOS.git
ARG CMSIS_FREERTOS_TAG=v11.3.0
ARG CMSIS_FREERTOS_SHA=4dd0035148cdc106f892877c27cba77d1de717d2
RUN git clone --depth=1 --branch=${CMSIS_FREERTOS_TAG} \
      https://github.com/ARM-software/CMSIS-FreeRTOS.git /opt/cmsis-freertos \
 && cd /opt/cmsis-freertos \
 && [ "$(git rev-parse HEAD)" = "${CMSIS_FREERTOS_SHA}" ]
ENV CMSIS_FREERTOS_PATH=/opt/cmsis-freertos

RUN chown -R developer:developer /opt/freertos /opt/lwip /opt/fatfs /opt/littlefs /opt/mbedtls /opt/wolfssl-src /opt/cmsis /opt/cmsis-freertos

USER developer
WORKDIR /home/src
